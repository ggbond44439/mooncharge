name = "ggbond44439/mooncharge"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/ggbond44439/mooncharge"

license = "Apache-2.0"

keywords = [ "ocpp", "ev-charging", "json-rpc", "protocol", "energy" ]

preferred_target = "wasm"

description = "Type-safe, transport-neutral OCPP 1.6J protocol and EV charging session toolkit for MoonBit."
